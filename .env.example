# SymptomWatch environment — copy to .env.local (or run `npm run setup`).
# DEMO ONLY: never configure this prototype with real patient data.

# --- Database -------------------------------------------------------------
# pglite  = embedded Postgres in .data/pglite (zero setup, local default)
# postgres = any Postgres, e.g. a demo-only Supabase project (required on Vercel)
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Only for a throwaway single-instance preview on a serverless host:
# ALLOW_EPHEMERAL_PGLITE=false

# --- Auth -----------------------------------------------------------------
# local    = built-in email/password auth (default, works everywhere)
# supabase = Supabase Auth (requires the two NEXT_PUBLIC_SUPABASE_* values)
AUTH_PROVIDER=local
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Required in production; at least 32 random characters (`npm run setup` generates one).
SESSION_SECRET=

# --- Demo data --------------------------------------------------------------
# Seeds known-password logins for the shared demo clinics (default: true in dev, false in production).
# SEED_SHARED_DEMO_ACCOUNTS=true
# DEMO_ACCOUNT_PASSWORD=SymptomWatch-Demo-2026

# --- Detection --------------------------------------------------------------
# rules = transparent rule engine (default). llm = disabled stub that refuses to run.
DETECTION_PROVIDER=rules
# Hard kill switch. Any value other than "false" prevents startup in this prototype.
EXTERNAL_AI_ENABLED=false

# --- URLs -------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
